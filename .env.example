# Database Configuration (Neon DB)
DB_URL=jdbc:postgresql://your-neon-endpoint.neon.tech/neondb?sslmode=require&channelBinding=require
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password

# JWT Configuration
# Used to sign and verify JWT tokens for authentication
# Generate a secure key: openssl rand -base64 32
# Minimum 32 characters recommended for HS256 algorithm
JWT_SECRET=your-super-secret-jwt-key-here-min-32-characters

# Server Configuration (Optional)
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=prod

